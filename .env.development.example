# Local development: copy to .env.development (git-ignored) and fill in the
# API keys. Read only with SOCRATE_ENV=development, which never reads .env and
# refuses to start unless Qdrant is on this machine (config.py). Qdrant runs
# from the backend's docker-compose.dev.yml.

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=socrate_docs_dev

# These calls cost money.
COHERE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Reading uploads from the app's private S3 bucket (services/file_parser.py).
# Without these, only files at public URLs can be read.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-southeast-2
AWS_BUCKET_NAME=socrate-data
