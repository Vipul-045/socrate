# Local development: copy to .env.development (git-ignored) and fill in the
# API keys. Read only with SOCRATE_ENV=development, which never reads .env and
# refuses to start unless Qdrant and S3 are on this machine (config.py). Qdrant runs
# from the backend's docker-compose.dev.yml.

QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=socrate_docs_dev

# These calls cost money.
COHERE_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=

# Uploaded files: the local MinIO (the backend's docker-compose.dev.yml), never
# AWS. Its root user is the dev access key.
S3_ENDPOINT=http://localhost:9000
AWS_BUCKET_NAME=socrate-dev
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=socrate-dev
AWS_SECRET_ACCESS_KEY=socrate-dev-secret
